# Groq API keys. Add keys from DIFFERENT Groq accounts: limits are per
# organisation, so two keys from the same account share one quota.
# When one key's quota is used up, the next key is used automatically.
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# or: GROQ_API_KEYS=key1,key2,key3

# GROQ_MODEL=openai/gpt-oss-120b           # Agent 2 mapping model
# AGENT3_LLM_MODEL=openai/gpt-oss-120b     # Agent 3 reasoning model
# GROQ_TOKENS_PER_MINUTE=7000              # per key; raise on a paid tier
# GROQ_REASONING_EFFORT=low                # gpt-oss reasoning effort
# SOV_MEMORY_PATH=memory/mapping_memory.json
