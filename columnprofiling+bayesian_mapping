import re
import numpy as np
import pandas as pd

from scipy.special import softmax
from rapidfuzz import fuzz


# ============================================================
# 1. COLUMN PROFILING
# ============================================================

def profile_column(series: pd.Series) -> dict:
    """
    Generate a statistical fingerprint for one SOV column.
    """

    s = series.dropna()
    n = len(series)

    if n == 0:
        return {
            "dtype": "empty",
            "total_count": 0,
            "missing_ratio": 1.0,
            "unique_ratio": 0.0,
        }

    # Convert to string for pattern analysis
    str_s = s.astype(str).str.strip()

    numeric = pd.to_numeric(s, errors="coerce")
    numeric_mask = numeric.notna()

    numeric_ratio = numeric_mask.mean()

    # Basic statistics
    profile = {
        "dtype": str(series.dtype),

        "total_count": n,

        "missing_ratio": float(series.isna().mean()),

        "unique_count": int(s.nunique()),

        "unique_ratio": float(s.nunique() / len(s)),

        "numeric_ratio": float(numeric_ratio),

        "string_ratio": float(1 - numeric_ratio),

        "zero_ratio": float((numeric == 0).mean())
        if numeric_ratio > 0 else 0.0,

        "negative_ratio": float((numeric < 0).mean())
        if numeric_ratio > 0 else 0.0,

        "mean": float(numeric.mean())
        if numeric_mask.any() else None,

        "median": float(numeric.median())
        if numeric_mask.any() else None,

        "std": float(numeric.std())
        if numeric_mask.sum() > 1 else None,

        "min": float(numeric.min())
        if numeric_mask.any() else None,

        "max": float(numeric.max())
        if numeric_mask.any() else None,

        "q1": float(numeric.quantile(0.25))
        if numeric_mask.any() else None,

        "q3": float(numeric.quantile(0.75))
        if numeric_mask.any() else None,

        "skewness": float(numeric.skew())
        if numeric_mask.sum() > 2 else None,

        "avg_string_length": float(str_s.str.len().mean()),

        "max_string_length": int(str_s.str.len().max()),

        "distinct_values": str_s.nunique(),

        "top_values": (
            str_s.value_counts()
            .head(10)
            .to_dict()
        )
    }

    # --------------------------------------------------------
    # Pattern detection
    # --------------------------------------------------------

    profile["patterns"] = {
        "zip_5_digit": float(
            str_s.str.fullmatch(r"\d{5}").mean()
        ),

        "year_4_digit": float(
            str_s.str.fullmatch(r"\d{4}").mean()
        ),

        "state_code": float(
            str_s.str.fullmatch(
                r"[A-Za-z]{2}"
            ).mean()
        ),

        "yes_no": float(
            str_s.str.lower().isin(
                ["yes", "no", "y", "n"]
            ).mean()
        ),

        "currency": float(
            str_s.str.contains(
                r"[$€£]|^\d+(\.\d+)?[KMB]$",
                case=False,
                regex=True
            ).mean()
        ),

        "decimal": float(
            str_s.str.fullmatch(
                r"\d+\.\d+"
            ).mean()
        )
    }

    return profile


def profile_dataframe(df: pd.DataFrame) -> dict:
    """
    Generate profiles for all columns.
    """

    profiles = {}

    for column in df.columns:
        profiles[column] = profile_column(df[column])

    return profiles


